ARG BASE_IMAGE=glm52-a800-baseline@sha256:2fdfbe865aecc01eee15a01fcce58bf7581244dbbc53cbe3ef0e0cce44bc489d
FROM ${BASE_IMAGE}

ARG SOURCE_COMMIT=a3317695428819d41437b1cb144404b3bfc05a92
ARG SOURCE_TREE=85619bd0ea0c71291a49f628fd4515b5fb70e9a1
ARG ROTATION_MANIFEST_SHA256=0275043c070c9127354997374e9bca1c70fe1308a7b2d057f992fadedef868e5
ARG ROTATIONS_SHA256=256ee5e4e92a2f28fa54a537daab543a6f1d54d87a569370325288186156235d

LABEL org.opencontainers.image.title="GLM-5.2 OSCAR A800 candidate"
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}"
LABEL ai.intellif.glm52.source-tree="${SOURCE_TREE}"
LABEL ai.intellif.glm52.rotation-manifest-sha256="${ROTATION_MANIFEST_SHA256}"
LABEL ai.intellif.glm52.rotations-sha256="${ROTATIONS_SHA256}"

COPY glm52_oscar_vllm/ /opt/vllm_glm52_v1/
COPY artifacts/phase2/20260727T2253Z_reap_rotation_fit_final/ /opt/oscar_artifacts/rotation_fit_v2/

ENV PYTHONPATH=/opt/vllm_glm52_v1
ENV VLLM_OSCAR_MLA_ROTATION_ARTIFACT=/opt/oscar_artifacts/rotation_fit_v2

WORKDIR /opt/vllm_glm52_v1

ENTRYPOINT ["/bin/bash"]
CMD ["-lc", "sleep infinity"]
